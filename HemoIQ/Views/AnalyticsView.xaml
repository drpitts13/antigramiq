<UserControl x:Class="HemoIQ.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:help="clr-namespace:HemoIQ.Help"
             help:Help.Topic="analytics">
    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Antibody ID Analytics" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#546E7A"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Include confirmations on or after this date"/>
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#546E7A"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="Include confirmations on or before this date"/>
                <Button Content="30 days" Command="{Binding Last30DaysCommand}" Padding="8,2" Margin="0,0,6,0"
                        ToolTip="Last 30 days through today"/>
                <Button Content="90 days" Command="{Binding Last90DaysCommand}" Padding="8,2" Margin="0,0,6,0"
                        ToolTip="Last 90 days through today"/>
                <Button Content="12 months" Command="{Binding Last12MonthsCommand}" Padding="8,2" Margin="0,0,6,0"
                        ToolTip="Last 12 months through today"/>
                <Button Content="All time" Command="{Binding AllTimeCommand}" Padding="8,2" Margin="0,0,12,0"
                        ToolTip="Every confirmed identification, including those without a date"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <Button Content="Help" Padding="8,2"
                        Command="{x:Static help:HelpCommands.ShowContext}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                        ToolTip="Open help for this section (F1)"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#546E7A" TextWrapping="Wrap">
            <Run Text="Confirmed antibody identifications"/>
            <Run Text=" ("/>
            <Run Text="{Binding RangeLabel, Mode=OneWay}"/>
            <Run Text="). Counts split multi-specific calls (anti-E; anti-K) into each specificity."/>
        </TextBlock>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,8">
            <Border Style="{StaticResource StatCard}" Background="#E3F2FD" BorderBrush="#90CAF9">
                <StackPanel>
                    <TextBlock Text="Confirmed specimens" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding ConfirmedSpecimens}" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Background="#E0F7FA" BorderBrush="#80DEEA">
                <StackPanel>
                    <TextBlock Text="Distinct IDs" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding DistinctSpecificities}" FontSize="22" FontWeight="Bold" Foreground="#00838F"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Background="#E8F5E9" BorderBrush="#A5D6A7">
                <StackPanel>
                    <TextBlock Text="Total occurrences" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding TotalOccurrences}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Background="#FFF3E0" BorderBrush="#FFCC80" Margin="0">
                <StackPanel>
                    <TextBlock Text="Most common" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding MostCommonId}" FontSize="18" FontWeight="Bold" Foreground="#EF6C00"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,8">
            <Border Style="{StaticResource StatCard}" Background="#F3E5F5" BorderBrush="#CE93D8"
                    ToolTip="Received date to confirmed identification, for investigations received in the range. Received is a date only, so this is an upper bound. Cancelled investigations are excluded.">
                <StackPanel>
                    <TextBlock Text="Received → confirmed (median)" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding ConfirmMedian}" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                    <TextBlock Text="{Binding ConfirmP90}" FontSize="11" Foreground="#6A1B9A"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Background="#F3E5F5" BorderBrush="#CE93D8"
                    ToolTip="Confirmed identification to supervisor review, where a review was recorded.">
                <StackPanel>
                    <TextBlock Text="Confirmed → reviewed (median)" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding ReviewMedian}" FontSize="20" FontWeight="Bold" Foreground="#6A1B9A"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Background="#FFEBEE" BorderBrush="#EF9A9A" Margin="0"
                    ToolTip="Active investigations in the range with no confirmed identification, older than the Preferences turnaround threshold.">
                <StackPanel>
                    <TextBlock Text="Overdue open investigations" FontSize="11" Foreground="#37474F"/>
                    <TextBlock Text="{Binding OverdueLabel}" FontSize="20" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid DockPanel.Dock="Bottom" Height="170" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Overdue open investigations" Margin="0,0,8,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open" VerticalAlignment="Top" Padding="10,2" Margin="6,0,0,0"
                            Command="{Binding OpenOverdueCommand}" ToolTip="Open the selected investigation on the Specimens tab."/>
                    <DataGrid ItemsSource="{Binding Overdue}" SelectedItem="{Binding SelectedOverdue}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Accession" Binding="{Binding Accession}" Width="140"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding Received}" Width="110"/>
                            <DataGridTextColumn Header="Age (days)" Binding="{Binding AgeDays}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Workload by technologist"
                      ToolTip="Confirmed identifications counted by confirmed date (Identified by) and supervisor reviews by review date (Reviewed by), within the range. Cancelled investigations are excluded. Names come from Users and roles.">
                <DataGrid ItemsSource="{Binding Workload}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Technologist" Binding="{Binding Display}" Width="*"/>
                        <DataGridTextColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="80"/>
                        <DataGridTextColumn Header="Multiple Ab" Binding="{Binding MultipleAntibodies}" Width="85"/>
                        <DataGridTextColumn Header="Reviews" Binding="{Binding Reviewed}" Width="70"/>
                        <DataGridTextColumn Header="Median TAT" Binding="{Binding MedianConfirmDisplay}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid DockPanel.Dock="Top" Height="280" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#B0BEC5" BorderThickness="1" Margin="0,0,8,0">
                <scottplot:WpfPlot x:Name="BarPlot"/>
            </Border>
            <Border Grid.Column="1" BorderBrush="#B0BEC5" BorderThickness="1">
                <scottplot:WpfPlot x:Name="TrendPlot"/>
            </Border>
        </Grid>

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Antibody" Binding="{Binding Antibody}" Width="*"/>
                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="100"/>
                <DataGridTextColumn Header="% of IDs" Binding="{Binding PercentDisplay}" Width="100"/>
                <DataGridTextColumn Header="Specimens" Binding="{Binding Specimens}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
