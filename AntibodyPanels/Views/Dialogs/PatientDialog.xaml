<Window x:Class="AntibodyPanels.Views.Dialogs.PatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:AntibodyPanels.Help"
        help:Help.Topic="specimens"
        Title="Patient" SizeToContent="WidthAndHeight" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16,12,16,12">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="DimGray"
                   Text="Permanent information shared by every specimen with this MRN. Changes are audited."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Label Content="MRN:" Grid.Row="0" VerticalAlignment="Center"/>
            <TextBox x:Name="MrnBox" Grid.Row="0" Grid.Column="1" IsEnabled="False" Opacity="0.6"
                     VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Name:" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" MaxLength="128"
                     VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Date of birth:" Grid.Row="2" VerticalAlignment="Center"/>
            <DatePicker x:Name="DobPicker" Grid.Row="2" Grid.Column="1"
                        VerticalAlignment="Center" Margin="0,2"/>

            <Label Content="Transfusion requirements:" Grid.Row="3" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox x:Name="RequirementsBox" Grid.Row="3" Grid.Column="1"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="70" Margin="0,2"
                     ToolTip="Standing requirements, e.g. K-negative, E-negative, Fy(a-); irradiated. Analysis names known antibodies whose antigen-negative requirement is not written here."/>

            <Label Content="Blood bank comments:" Grid.Row="4" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox x:Name="CommentsBox" Grid.Row="4" Grid.Column="1"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="70" Margin="0,2"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Help" Width="84" Margin="0,0,8,0"
                    Command="{x:Static help:HelpCommands.ShowContext}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    ToolTip="Open help for this section (F1)"/>
            <Button Content="Save" Width="84" Margin="0,0,8,0" Click="SaveClick" IsDefault="True"/>
            <Button Content="Cancel" Width="84" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
